{
  "name": "otp-client",
  "version": "0.1.5",
  "description": "Desktop companion for browsing one-trick builds with one-click rune/item import via the official League Client API",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.otp.client",
    "productName": "OTP Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lcu.js",
      "tier-preload.js",
      "tierlist.html",
      "summoner-preload.js",
      "summoner.html",
      "package.json",
      "assets/"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "OTP Client"
    }
  },
  "dependencies": {
    "league-connect": "^5.5.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  }
}

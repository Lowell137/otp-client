{
  "name": "otp-client",
  "version": "0.1.19",
  "description": "Desktop companion for browsing one-trick builds with one-click rune/item import via the official League Client API",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.otp.client",
    "productName": "OTP Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lcu.js",
      "lcu-creds.js",
      "lobby.js",
      "postgame.js",
      "opgg.js",
      "tier-preload.js",
      "tierlist.html",
      "summoner-preload.js",
      "summoner.html",
      "overlay-preload.js",
      "overlay.html",
      "shell.css",
      "shell.js",
      "wallpapers.html",
      "wallpapers-preload.js",
      "bg.js",
      "changelog.json",
      "whatsnew.js",
      "package.json",
      "assets/"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "OTP Client",
      "artifactName": "OTP-Client-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lowell137",
        "repo": "otp-client",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "build/otp-watch.exe",
        "to": "otp-watch.exe"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^2.16.4",
    "league-connect": "^5.5.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lowell137/otp-client.git"
  }
}
